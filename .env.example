# Easy Labs Ltd — Backend Environment Configuration

# Server Port
PORT=3000

# ==============================================================================
# BREVO (SENDINBLUE) SETTINGS
# ==============================================================================

# 1. Brevo REST API v3 Key (Recommended)
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=YOUR_BREVO_API_KEY_HERE

# 2. Sender Details (Must be a verified sender in your Brevo account)
# Set up verified senders at: https://app.brevo.com/senders
SENDER_NAME=Easy Labs Ltd
SENDER_EMAIL=info@easylabsltd.com

# 3. Target Inbox (Where notifications of new inquiries/leads are sent)
ADMIN_EMAIL=info@easylabsltd.com

# ==============================================================================
# OPTIONAL: Brevo SMTP Relay Settings (Alternative to API Key)
# ==============================================================================
# BREVO_SMTP_LOGIN=your-brevo-smtp-login@smtp-brevo.com
# BREVO_SMTP_KEY=your-brevo-smtp-master-key
